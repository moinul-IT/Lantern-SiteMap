{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/manage",
      "rewrite": "/manage.html",
      "allowedRoles": [
        "contentmanager"
      ]
    },
    {
      "route": "/manage/*",
      "allowedRoles": [
        "contentmanager"
      ]
    },
    {
      "route": "/manage.html",
      "allowedRoles": [
        "contentmanager"
      ]
    },
    {
      "route": "/manage.txt",
      "allowedRoles": [
        "contentmanager"
      ]
    },
    {
      "route": "/api/content",
      "methods": [
        "GET"
      ],
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/content",
      "methods": [
        "PUT"
      ],
      "allowedRoles": [
        "contentmanager"
      ]
    },
    {
      "route": "/api/me",
      "methods": [
        "GET"
      ],
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "route": "/icons/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/_next/static/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/maplibre/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/403.html",
      "statusCode": 403
    },
    "404": {
      "rewrite": "/404.html"
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/_next/*",
      "/icons/*",
      "/photos/*",
      "/maplibre/*",
      "/*.{js,css,json,webmanifest,png,jpg,jpeg,svg,ico,txt,html,pbf,woff,woff2}"
    ]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".json": "application/json",
    ".pbf": "application/x-protobuf"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
